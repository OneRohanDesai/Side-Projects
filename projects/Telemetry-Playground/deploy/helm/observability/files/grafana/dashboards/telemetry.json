{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Packets Received",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(telemetry_packets_received_total)",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "Packets Sent",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(telemetry_packets_sent_total)",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "Packets / sec",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(telemetry_packets_received_total[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "pps", "decimals": 2 },
        "overrides": []
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "p95 Latency",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(telemetry_request_latency_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3 },
        "overrides": []
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Traffic by Generator",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (generator) (rate(telemetry_packets_sent_total[1m]))",
          "legendFormat": "{{generator}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "pps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "showPoints": "never" } },
        "overrides": []
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Traffic by Receiver",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (receiver) (rate(telemetry_packets_received_total[1m]))",
          "legendFormat": "{{receiver}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "pps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "showPoints": "never" } },
        "overrides": []
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Latency (avg / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "id": 7,
      "targets": [
        {
          "expr": "rate(telemetry_request_latency_seconds_sum[1m]) / rate(telemetry_request_latency_seconds_count[1m])",
          "legendFormat": "avg",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(telemetry_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Errors & Malformed",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(telemetry_packets_send_errors_total[1m]))",
          "legendFormat": "send errors",
          "refId": "A"
        },
        {
          "expr": "sum(rate(telemetry_malformed_packets_total[1m]))",
          "legendFormat": "malformed",
          "refId": "B"
        },
        {
          "expr": "sum(rate(telemetry_packets_rejected_total[1m]))",
          "legendFormat": "rejected",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["telemetry", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Telemetry Overview",
  "uid": "telemetry-overview",
  "version": 1
}
