[global]
origin = bottom-center
offset = 0x40
width = (150, 500)
height = (0, 120)
notification_limit = 3
padding = 16
horizontal_padding = 20
frame_width = 1
frame_color = "#FFFFFF"
separator_height = 0
font = JetBrainsMono Nerd Font 11
background = "#000000"
foreground = "#FFFFFF"
corner_radius = 0
script = @HOME@/.config/dunst/play_sound.sh

[urgency_low]
timeout = 5

[urgency_normal]
timeout = 8

[urgency_critical]
timeout = 0
frame_color = "#bf616a"
