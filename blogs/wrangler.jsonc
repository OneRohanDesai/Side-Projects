{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inkboard-blogs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLIC_SITE_ORIGIN": "*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault-plates",
      "database_id": "dac528c3-9ee5-4612-95f6-16e256f61d53",
      "migrations_dir": "../architecture/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "inkboard-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "666ee8af461942a9bdcf54b0bac3a9d7"
    },
    {
      "binding": "CACHE",
      "id": "31d3840cc6fc4d0db3d65dcd707a179d"
    }
  ]
}
