{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inkboard-blogs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLIC_SITE_ORIGIN": "*"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inkboard-blogs",
      "database_id": "f4cb3214-3a9d-4b7e-b840-82e3a3dd603b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "inkboard-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "666ee8af461942a9bdcf54b0bac3a9d7"
    },
    {
      "binding": "CACHE",
      "id": "31d3840cc6fc4d0db3d65dcd707a179d"
    }
  ]
}
