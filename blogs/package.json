{
  "name": "inkboard-blogs",
  "version": "1.0.0",
  "private": true,
  "description": "Inkboard — Rohan's blog engine for game theory, poker, and geopolitics",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply inkboard-blogs --local",
    "db:remote": "wrangler d1 migrations apply inkboard-blogs --remote",
    "secret:password": "wrangler secret put ADMIN_PASSWORD"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.118.0"
  }
}
